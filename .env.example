# Copy this file to .env and fill in your values.
# docker-compose reads .env automatically. Do NOT commit .env.

# Qdrant host for the app container.
# Must be "qdrant" (the docker-compose service name) — do not change this.
QDRANT_HOST=qdrant

INGEST_SHARED_SECRET=dev-secret

# GCP project and region for Vertex AI
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1         # or your preferred region
ENVIRONMENT=development             # enables pretty logs instead of JSON